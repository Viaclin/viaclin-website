# Copy to .env for local work. In Vercel, add the same names under Project Settings, Environment Variables.
# Every value is optional. An empty value switches that feature off; nothing breaks.

# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX. Loads after analytics consent.
PUBLIC_GA4_ID=

# Microsoft Clarity project ID (heatmaps and session insight). Loads after insights consent.
PUBLIC_CLARITY_ID=

# Google Search Console HTML tag verification code (the content value, not the whole tag).
PUBLIC_GSC_VERIFICATION=

# Web3Forms access key for info@viaclin.com. Without it the contact form composes an email instead.
PUBLIC_WEB3FORMS_KEY=
