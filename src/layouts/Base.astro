---
// Page shell: head, skip link, header, main, footer, global dialogs and client scripts.
import '@fontsource/noto-sans/latin-400.css';
import '@fontsource/noto-sans/latin-600.css';
import '@fontsource/noto-sans/latin-700.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import ContactModal from '../components/ContactModal.astro';
import SearchModal from '../components/SearchModal.astro';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Home page sets this so the header leaves room for the docking descriptor. */
  docks?: boolean;
}

const { title, description, path, noindex = false, schema, docks = false } = Astro.props;
---

<!doctype html>
<html lang="en-IE" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <Seo title={title} description={description} path={path} noindex={noindex} schema={schema} />
    <script is:inline>
      // Runs before first paint: mark JS as present, pick the theme, honour capture flags.
      // It sits below the Seo block so that the theme colour and colour scheme metas exist when it runs.
      (function () {
        var root = document.documentElement;
        root.classList.remove('no-js');
        root.classList.add('js');
        // Light on every device. Dark shows when the visitor has picked it with the footer theme button;
        // the device setting plays no part.
        var stored = null;
        try { stored = localStorage.getItem('viaclin-theme'); } catch (e) {}
        var theme = stored === 'dark' ? 'dark' : 'light';
        var query = new URLSearchParams(location.search);
        if (query.get('static')) root.classList.add('static');
        if (query.get('theme') === 'dark' || query.get('theme') === 'light') theme = query.get('theme');
        root.setAttribute('data-theme', theme);
        // The browser bar on phones takes the page ground of the same theme, and the colour scheme meta declares
        // that theme. theme.ts keeps both in step after a switch.
        var bar = document.querySelector('meta[name="theme-color"]');
        var colour = bar && bar.getAttribute(theme === 'dark' ? 'data-dark' : 'data-light');
        if (colour) bar.setAttribute('content', colour);
        var scheme = document.querySelector('meta[name="color-scheme"]');
        var declared = scheme && scheme.getAttribute(theme === 'dark' ? 'data-dark' : 'data-light');
        if (declared) scheme.setAttribute('content', declared);
        // Failsafe: .js hides every [data-reveal] before paint. If the script bundle never arrives,
        // main.ts never marks the page ready, so fall back to the static rules, which show everything.
        setTimeout(function () {
          if (!root.classList.contains('is-ready')) root.classList.add('static');
        }, 4000);
      })();
    </script>
    <script>
      // In the head so the browser finds the bundle while it is still parsing the body.
      // A module script is deferred by definition: it runs after parsing, so every init step
      // in main.ts finds the DOM in place, the same as when this block sat at the end of body.
      import '../scripts/main.ts';
    </script>
  </head>
  <body data-docks={docks ? 'true' : undefined}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header path={path} />

    <div class="print-brand" aria-hidden="true"><Logo variant="lockup" label="" /></div>

    <main id="main" tabindex="-1" data-pagefind-body>
      <slot />
    </main>

    <Footer />

    <button class="to-top glass" type="button" id="to-top" aria-label="Back to top">
      <Icon name="arrow-up" />
    </button>

    <aside class="mobile-cta glass" id="mobile-cta" aria-label="Start a Conversation">
      <a class="btn btn--primary js-convo" href="/contact" data-track="cta_click" data-track-place="mobile-bar">Start a Conversation</a>
    </aside>

    <ContactModal />
    <SearchModal />
    <ConsentBanner />

    <div class="sr-only" aria-live="polite" id="live-region"></div>
  </body>
</html>
