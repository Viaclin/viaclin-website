---
// Closing band. Inner pages use the navy ground; the home page sets `video` for the last-mile film.
import VideoBand from './VideoBand.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  line?: string;
  label?: string;
  topic?: string;
  video?: boolean;
}

const {
  title = "Let's connect.",
  line = 'One-step connect:',
  label = 'Start a conversation',
  topic,
  video = false,
} = Astro.props;
const href = topic ? `/contact?topic=${topic}` : '/contact';
---

{video ? (
  <VideoBand video="driver" id="contact-band" height="mid" labelledby="contact-band-title">
    <div class="cband-film glass glass--film" data-reveal>
      <p class="eyebrow eyebrow--on-film">The last mile</p>
      <h2 id="contact-band-title">{title}</h2>
      <p>{line} <a class="text-link text-link--inline text-link--on-film" href={`mailto:${site.email}`}>{site.email}</a></p>
      <div class="actions">
        <a class="btn btn--primary js-convo" href={href} data-topic={topic} data-track="cta_click" data-track-place="contact-band">{label}</a>
      </div>
    </div>
  </VideoBand>
) : (
  <section class="cband" aria-labelledby="contact-band-title">
    <div class="container cband__inner">
      <div data-reveal>
        <h2 id="contact-band-title">{title}</h2>
        <p>{line} <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="actions" data-reveal style="--d:120ms">
        <a class="btn btn--primary js-convo" href={href} data-topic={topic} data-track="cta_click" data-track-place="contact-band">{label}</a>
      </div>
    </div>
  </section>
)}

<style>
  .cband-film {
    max-width: 640px;
    padding: clamp(28px, 4vw, 52px);
    border-radius: var(--radius-xl);
  }

  .cband-film h2 {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .cband-film p:not(.eyebrow) {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
  }

  .cband-film .actions {
    margin-top: var(--space-6);
  }
</style>
