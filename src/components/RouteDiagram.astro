---
// The route, discovery to S&OP, under the home hero. One horizontal artboard, shown from 641 px up: at 640 px
// and below the hero carries the technician film instead and the route steps aside.
// Decorative SVG; the caption beneath carries the meaning as text.
const stops = ['Discovery', 'Clinical', 'Production', 'Launch', 'S&OP'];
const xs = [40, 270, 500, 730, 960];
---

<div class="route" data-reveal="fade" data-reveal-at="half">
  <svg viewBox="0 0 1000 132" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <line class="route__line" x1="40" y1="40" x2="960" y2="40" pathLength="1000"></line>
    <circle class="route__pulse" r="5" cx="40" cy="40" opacity="0">
      <animate attributeName="cx" values="40;960" dur="7s" begin="2.2s" repeatCount="indefinite"></animate>
      <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.06;0.94;1" dur="7s" begin="2.2s" repeatCount="indefinite"></animate>
    </circle>
    {xs.map((x, i) => <circle class="route__node" cx={x} cy="40" r="9" style={`--i:${i}`}></circle>)}
    {stops.map((stop, i) => (
      <text class="route__label" x={xs[i]} y="76" text-anchor="middle" style={`--i:${i}`}>{stop}</text>
    ))}
    <path class="route__bracket" d="M40 104 v14 h920 v-14"></path>
  </svg>

  <p class="route__caption">End-to-end delivery</p>
</div>
