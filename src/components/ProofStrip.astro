---
// Four short facts, under the services band that follows the hero. The strip's top edge adapts to the band
// above it (see the proof strip rules in components.css).
const facts = [
  { bold: 'Concept to Treatment', small: 'Development and commercial supply' },
  { bold: 'EU, US and UK', small: 'Three regulatory jurisdictions' },
  { bold: 'Remote-first', small: 'On your programme within days' },
  { bold: 'Active AI', small: 'In use on every engagement' },
];
---

<div class="proof">
  <div class="container">
    <ul class="proof__grid" role="list">
      {facts.map((fact, index) => (
        <li class="proof__item" data-reveal style={`--d:${index * 80}ms`}>
          <strong>{fact.bold}</strong>
          <span>{fact.small}</span>
        </li>
      ))}
    </ul>
  </div>
</div>
