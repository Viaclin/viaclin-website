---
// Our Team hero graphic: the network, narrowed by key criteria to one consultant, who is then joined to the
// problem. Decorative; the caption beneath says the same in words.
//
// Built to survive a browser that darkens the page by itself. Every word is HTML text on an HTML ground,
// never SVG text, so each word is recoloured with the shape behind it. Marks that must stay light on green
// (the ticks, the chosen consultant) are SVG strokes, which such a browser leaves as drawn; marks that sit on
// a light disc (the other consultants) are HTML borders, which it recolours with the disc. The mesh lines
// use a mid tone that reads on a light ground and on a darkened one.
//
// On reveal the criteria tick one after another, the consultants who miss a criterion fall back, the chosen
// one settles and the match line draws up to the problem. It plays once, in under four seconds, then holds.
const criteria = ['Specialism', 'Phase', 'Region', 'Systems'];

// The pool. x and y are percentages of the pool box. tint is the specialism: "match" is the one the task needs.
// out is the criterion (1 to 4) that sets a consultant aside; the consultant with no out is the match,
// and sits on the centre line so the match line can run straight up through the gap in the criteria.
const people = [
  { x: 7, y: 46, tint: 'ink', out: 1 },
  { x: 20, y: 84, tint: 'slate', out: 1 },
  { x: 28, y: 28, tint: 'slate', out: 1 },
  { x: 40, y: 62, tint: 'match', out: 3 },
  { x: 50, y: 18, tint: 'match', out: 0 },
  { x: 60, y: 62, tint: 'ink', out: 1 },
  { x: 72, y: 28, tint: 'match', out: 4 },
  { x: 80, y: 84, tint: 'match', out: 2 },
  { x: 50, y: 88, tint: 'slate', out: 1 },
  { x: 93, y: 46, tint: 'ink', out: 1 },
];

const links = [
  [0, 2], [0, 1], [2, 4], [2, 3], [1, 3], [3, 4], [4, 5], [3, 5], [3, 8],
  [4, 6], [5, 8], [5, 6], [5, 7], [6, 9], [7, 9], [1, 8], [7, 8],
];
---

<figure class="tm" data-reveal="fade" data-reveal-at="half">
  <div class="tm__art" aria-hidden="true" data-pagefind-ignore>
    <div class="tm__brief-wrap">
      <div class="tm__brief glass">
        <p class="eyebrow">Your programme</p>
        <p class="tm__task">Cold chain set-up for a Phase III launch</p>
      </div>
      <span class="tm__pill"><span class="tm__dot"></span>Matched consultant</span>
    </div>

    <div class="tm__criteria">
      {criteria.map((name, i) => (
        <span class="tm__crit" style={`--i:${i}`}>
          <span class="tm__tick"><svg viewBox="0 0 12 12" focusable="false"><path d="M2.6 6.3l2.2 2.2 4.7-4.9"></path></svg></span>{name}
        </span>
      ))}
    </div>

    <div class="tm__pool">
      <svg class="tm__links" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
        {links.map(([a, b]) => (
          <line x1={people[a].x} y1={people[a].y} x2={people[b].x} y2={people[b].y} vector-effect="non-scaling-stroke"></line>
        ))}
      </svg>
      <span class="tm__wire"></span>
      {people.map((p) => (
        <span
          class:list={['tm__node', `tm__node--${p.tint}`, p.out ? 'tm__node--out' : 'tm__node--lead']}
          style={`--x:${p.x}%;--y:${p.y}%;--out:${p.out}`}
        >
          {!p.out && (
            <svg class="tm__me" viewBox="0 0 36 36" focusable="false">
              <circle cx="18" cy="13.68" r="5.48"></circle>
              <path d="M7.12 40V34.92a10.88 10.88 0 0 1 21.76 0V40"></path>
            </svg>
          )}
        </span>
      ))}
    </div>
  </div>
  <figcaption class="tm__caption">Key criteria narrow the network to the consultant who fits the task.</figcaption>
</figure>

<style>
  /* Sizes for a narrow column first; the wide layout follows from the figure's own width, not the screen's.
     It keeps to the content grid: beside the copy its right edge meets the container edge, and once the
     hero stacks it starts on the copy's left edge. */
  .tm {
    container-type: inline-size;
    width: 100%;
    max-width: 560px;
    margin-inline: auto 0;
  }

  @media (max-width: 900px) {
    .tm {
      margin-inline: 0;
    }
  }

  /* The figure shows at once in its start look. The sequence alone waits for half of it to be in view, so
     a short phone never shows a blank patch under the jump links. */
  :global(.js) .tm[data-reveal] {
    opacity: 1;
  }

  .tm__art {
    --node: 36px;
    --pool-h: 190px;
    --gutter: 28px;
    --chip-h: 40px;
    --crit-h: calc(var(--chip-h) * 2 + 10px);
    --gap-a: 34px;
    --gap-b: 22px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* the problem: a glass card, with the match badge sitting on its lower edge */
  .tm__brief-wrap {
    position: relative;
    z-index: 1;
  }

  .tm__brief {
    padding: 18px 22px 26px;
  }

  .tm__task {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fg);
    text-wrap: balance;
  }

  .tm__pill {
    position: absolute;
    left: 50%;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    padding: 0 16px 0 12px;
    border: 1.5px solid var(--accent);
    border-radius: var(--radius-pill);
    background: var(--bg);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1;
    color: var(--link);
    white-space: nowrap;
    transform: translate(-50%, 50%);
  }

  .tm__dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  /* the criteria: two columns either side of a centre gap that the match line runs through */
  .tm__criteria {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--gutter) minmax(0, 1fr);
    gap: 10px 8px;
    margin-top: var(--gap-a);
  }

  .tm__crit:nth-child(odd) {
    grid-column: 1;
  }

  .tm__crit:nth-child(even) {
    grid-column: 3;
  }

  .tm__crit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: var(--chip-h);
    padding: 0 12px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--rule));
    border-radius: var(--radius-pill);
    background: var(--bg-raised);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
    color: var(--fg);
    white-space: nowrap;
  }

  .tm__tick {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    flex: none;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    background: var(--accent);
  }

  .tm__tick svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: var(--bg);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* the pool: mesh lines under the consultants */
  .tm__pool {
    position: relative;
    height: var(--pool-h);
    margin-top: var(--gap-b);
  }

  .tm__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .tm__links line {
    stroke: var(--fg-3);
    stroke-width: 1.5;
    opacity: 0.4;
  }

  /* the match line: from the chosen consultant's centre up to the lower edge of the problem card */
  .tm__wire {
    position: absolute;
    left: 50%;
    bottom: calc(var(--pool-h) * 0.82);
    width: 2px;
    height: calc(var(--pool-h) * 0.18 + var(--gap-b) + var(--crit-h) + var(--gap-a));
    border-radius: 2px;
    background: var(--accent);
    transform: translateX(-50%);
    transform-origin: 50% 100%;
  }

  /* a consultant: an opaque disc, so the mesh stops at its edge, in the ring and fill of a specialism */
  .tm__node {
    --ring: var(--fg);
    --fill: var(--bg);
    --glyph: var(--fg);
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--node);
    height: var(--node);
    overflow: hidden;
    border: 2px solid var(--ring);
    border-radius: 50%;
    background: var(--fill);
    transform: translate(-50%, -50%);
  }

  /* specialism tints */
  .tm__node--slate {
    --ring: var(--fg-3);
    --fill: var(--diagram-fill);
  }

  .tm__node--match {
    --ring: var(--accent);
    --fill: color-mix(in srgb, var(--accent) 14%, var(--bg));
  }

  /* the person: a head and a line of shoulders, in borders, so a darkened page recolours them with the disc */
  .tm__node::before,
  .tm__node::after {
    content: '';
    position: absolute;
    left: 50%;
    border: 2px solid var(--glyph);
    transform: translateX(-50%);
  }

  .tm__node::before {
    top: 20%;
    width: 36%;
    height: 36%;
    border-radius: 50%;
  }

  .tm__node::after {
    top: 64%;
    width: 66%;
    height: 60%;
    border-radius: 999px 999px 0 0;
  }

  /* set aside: the disc stays, its colours fall back towards the ground */
  .tm__node--out {
    border-color: color-mix(in srgb, var(--ring) 30%, var(--bg));
    background: color-mix(in srgb, var(--fill) 45%, var(--bg));
  }

  .tm__node--out::before,
  .tm__node--out::after {
    border-color: color-mix(in srgb, var(--glyph) 26%, var(--bg));
  }

  /* the matched consultant: filled in the action green, with the same person drawn in SVG strokes on top */
  .tm__node--lead {
    border-color: var(--action);
    background: var(--action);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 24%, transparent);
    transform: translate(-50%, -50%) scale(1.12);
  }

  .tm__node--lead::before,
  .tm__node--lead::after {
    border-color: transparent;
  }

  .tm__me {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--action-fg);
    stroke-width: 2;
  }

  .tm__caption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--fg-2);
    text-align: center;
    text-wrap: balance;
  }

  /* wide: the four criteria in one row, the gap still on the centre line. It starts at the width where the
     longest name still has its full padding. */
  @container (min-width: 550px) {
    .tm__art {
      --node: 40px;
      --pool-h: 176px;
      --gutter: 24px;
      --crit-h: var(--chip-h);
    }

    /* a tighter tick gap and padding, so the longest name keeps clear of the pill's curve */
    .tm__crit {
      gap: 6px;
      padding-inline: 10px;
    }

    .tm__criteria {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) var(--gutter) minmax(0, 1fr) minmax(0, 1fr);
    }

    .tm__crit:nth-child(1) {
      grid-column: 1;
    }

    .tm__crit:nth-child(2) {
      grid-column: 2;
    }

    .tm__crit:nth-child(3) {
      grid-column: 4;
    }

    .tm__crit:nth-child(4) {
      grid-column: 5;
    }
  }

  /* the narrowest phones: smaller discs and chips, type held at 13 px */
  @container (max-width: 339px) {
    .tm__art {
      --node: 34px;
    }

    .tm__crit {
      gap: 7px;
      padding: 0 10px;
      font-size: var(--text-xs);
    }

    .tm__brief {
      padding: 16px 18px 26px;
    }
  }

  /* The sequence. Each part runs one keyframe from its start look back to its resting style, held paused
     on that start look until the reveal adds .is-in. Once it has played, the resting style rules, so a
     theme change later recolours at once. Without script, with reduced motion or in a static capture
     nothing runs and the finished match shows. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .tm .tm__crit {
      animation: tm-crit 320ms var(--ease) calc(450ms + var(--i) * 600ms) backwards paused;
    }

    :global(.js) .tm .tm__tick {
      animation: tm-tick 320ms var(--ease) calc(450ms + var(--i) * 600ms) backwards paused;
    }

    :global(.js) .tm .tm__tick svg {
      animation: tm-check 320ms var(--ease) calc(550ms + var(--i) * 600ms) backwards paused;
    }

    :global(.js) .tm .tm__node--out {
      animation: tm-out 450ms var(--ease) calc(650ms + (var(--out) - 1) * 600ms) backwards paused;
    }

    :global(.js) .tm .tm__node--out::before,
    :global(.js) .tm .tm__node--out::after {
      animation: tm-glyph 450ms var(--ease) calc(650ms + (var(--out) - 1) * 600ms) backwards paused;
    }

    :global(.js) .tm .tm__node--lead {
      animation: tm-lead 500ms var(--ease) 2750ms backwards paused;
    }

    :global(.js) .tm .tm__node--lead::before,
    :global(.js) .tm .tm__node--lead::after {
      animation: tm-glyph 500ms var(--ease) 2750ms backwards paused;
    }

    :global(.js) .tm .tm__me {
      animation: tm-me 500ms var(--ease) 2750ms backwards paused;
    }

    :global(.js) .tm .tm__wire {
      animation: tm-wire 600ms var(--ease-in-out) 3000ms backwards paused;
    }

    :global(.js) .tm .tm__pill {
      animation: tm-pill 420ms var(--ease) 3450ms backwards paused;
    }

    :global(.js) .tm.is-in .tm__crit,
    :global(.js) .tm.is-in .tm__tick,
    :global(.js) .tm.is-in .tm__tick svg,
    :global(.js) .tm.is-in .tm__node,
    :global(.js) .tm.is-in .tm__node::before,
    :global(.js) .tm.is-in .tm__node::after,
    :global(.js) .tm.is-in .tm__me,
    :global(.js) .tm.is-in .tm__wire,
    :global(.js) .tm.is-in .tm__pill {
      animation-play-state: running;
    }
  }

  @keyframes tm-crit {
    from {
      border-color: var(--rule);
      color: var(--fg-3);
    }
  }

  @keyframes tm-tick {
    from {
      border-color: var(--rule);
      background-color: transparent;
    }
  }

  @keyframes tm-check {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }

  @keyframes tm-out {
    from {
      border-color: var(--ring);
      background-color: var(--fill);
    }
  }

  @keyframes tm-glyph {
    from {
      border-color: var(--glyph);
    }
  }

  @keyframes tm-lead {
    from {
      border-color: var(--ring);
      background-color: var(--fill);
      box-shadow: 0 0 0 0 transparent;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  @keyframes tm-me {
    from {
      opacity: 0;
    }
  }

  @keyframes tm-wire {
    from {
      transform: translateX(-50%) scaleY(0);
    }
  }

  @keyframes tm-pill {
    from {
      opacity: 0;
      transform: translate(-50%, 50%) scale(0.85);
    }
  }
</style>
