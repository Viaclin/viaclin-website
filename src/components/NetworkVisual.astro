---
// One lead, six specialisms. Decorative; the network section's copy says the same in words.
// The labels are HTML text laid over the drawing, not SVG text. A browser that darkens the page by itself
// recolours HTML text with its ground, so the words stay readable in light, dark and darkened rendering;
// SVG text was left with a light halo behind recoloured words. Each label hangs a fixed distance above or
// below its node, so the gap holds as the drawing scales.
const W = 480;
const H = 384;
const spokes = [
  { x: 240, y: 52, label: 'IRT', side: 'above' },
  { x: 398, y: 118, label: 'QP release', side: 'above' },
  { x: 398, y: 266, label: 'Cold chain', side: 'below' },
  { x: 240, y: 330, label: 'Forecasting', side: 'below' },
  { x: 82, y: 266, label: 'Packaging', side: 'below' },
  { x: 82, y: 118, label: 'Regulatory', side: 'above' },
];
const R = 9;
const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(3)}%`;
---

<div class="netviz" data-reveal="scale" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} xmlns="http://www.w3.org/2000/svg" focusable="false">
    <circle class="netviz__orbit" cx="240" cy="190" r="158"></circle>
    {spokes.map((s, i) => <line class="netviz__spoke" x1="240" y1="190" x2={s.x} y2={s.y} pathLength="180" style={`--i:${i}`}></line>)}
    {spokes.map((s, i) => <circle class="netviz__node" cx={s.x} cy={s.y} r={R} style={`--i:${i}`}></circle>)}
    <circle class="netviz__ring" cx="240" cy="190" r="10">
      <animate attributeName="r" values="10;36" dur="2.8s" repeatCount="indefinite"></animate>
      <animate attributeName="opacity" values="0.7;0" dur="2.8s" repeatCount="indefinite"></animate>
    </circle>
    <circle class="netviz__lead" cx="240" cy="190" r="12"></circle>
  </svg>
  {spokes.map((s) => (
    <span
      class:list={['netviz__label', `netviz__label--${s.side}`]}
      style={`left:${pct(s.x, W)};top:${pct(s.side === 'above' ? s.y - R : s.y + R, H)}`}
    >{s.label}</span>
  ))}
  <!-- in the wedge between the two right-hand spokes, clear of both and of the pulse ring -->
  <span class="netviz__label netviz__label--lead" style={`left:${pct(282, W)};top:${pct(190, H)}`}>Your lead</span>
</div>

<style>
  .netviz {
    position: relative;
  }

  .netviz svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .netviz__orbit {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1.5;
    stroke-dasharray: 3 7;
  }

  /* the mid tone reads as before on both themes and stays visible when a browser darkens the page */
  .netviz__spoke {
    stroke: var(--fg-3);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.85;
  }

  .netviz__node {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 2.5;
    transition: fill var(--dur-2) var(--ease);
  }

  :global(.section--mist) .netviz__node {
    fill: var(--bg-alt);
  }

  .netviz__lead {
    fill: var(--accent);
  }

  .netviz__ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }

  /* a fill in the ground colour knocks the dotted orbit out behind each word. It is an HTML fill, so a browser
     that darkens the page darkens it with the ground, and the words keep their contrast */
  .netviz__label {
    position: absolute;
    padding-inline: 6px;
    border-radius: var(--radius-sm);
    background: var(--bg);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--fg-2);
    white-space: nowrap;
    pointer-events: none;
  }

  :global(.section--mist) .netviz__label {
    background: var(--bg-alt);
  }

  .netviz__label--above {
    transform: translate(-50%, calc(-100% - 7px));
  }

  .netviz__label--below {
    transform: translate(-50%, 7px);
  }

  /* link green on the same ground fill: no halo, and never light text on a light chip */
  .netviz__label--lead {
    font-weight: 700;
    color: var(--link);
    transform: translateY(-50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .netviz .netviz__spoke {
      stroke-dasharray: 180;
      stroke-dashoffset: 180;
    }

    :global(.js) .netviz.is-in .netviz__spoke {
      animation: route-draw 900ms var(--ease) forwards;
      animation-delay: calc(200ms + var(--i) * 110ms);
    }

    :global(.js) .netviz .netviz__node {
      opacity: 0;
    }

    :global(.js) .netviz.is-in .netviz__node {
      animation: route-fade 500ms var(--ease) forwards;
      animation-delay: calc(700ms + var(--i) * 110ms);
    }
  }

  @media (max-width: 900px) {
    /* margin-inline: auto stops the grid item stretching, so the width has to be stated for the SVG to fill it */
    .netviz {
      width: 100%;
      max-width: 440px;
      margin-inline: auto;
    }
  }
</style>
