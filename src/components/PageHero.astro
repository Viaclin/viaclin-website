---
// Inner page hero: breadcrumb, H1, lead, optional action and optional framed film.
// title is the plain-text heading and is always required. titleHtml is optional: when set, the H1 renders
// that markup instead (a line break or an emphasised word, for example). The markup must come from the
// page author, never from user input, because it is placed in the page as written.
import VideoFrame from './VideoFrame.astro';
import type { VideoKey } from '../data/videos';

interface Crumb {
  title: string;
  href?: string;
}

interface Props {
  /** The heading as plain text. */
  title: string;
  /** Author-written markup for the H1. Never pass user input. */
  titleHtml?: string;
  lead: string;
  eyebrow?: string;
  crumbs?: Crumb[];
  cta?: { label: string; topic?: string };
  video?: VideoKey;
}

const { title, titleHtml, lead, eyebrow, crumbs, cta, video } = Astro.props;
const href = cta?.topic ? `/contact?topic=${cta.topic}` : '/contact';
---

<section class="page-hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container">
    {crumbs && (
      <nav aria-label="Breadcrumb" data-reveal="fade">
        <ol class="breadcrumb">
          <li><a href="/">Home</a></li>
          {crumbs.map((crumb) => (
            <li>{crumb.href ? <a href={crumb.href}>{crumb.title}</a> : <span aria-current="page">{crumb.title}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <div class:list={[video && 'split']}>
      <div class="page-hero__copy">
        {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
        {titleHtml ? <h1 data-reveal style="--d:60ms" set:html={titleHtml} /> : <h1 data-reveal style="--d:60ms">{title}</h1>}
        <p class="lead" data-reveal style="--d:140ms">{lead}</p>
        {cta && (
          <div class="actions" data-reveal style="--d:220ms">
            <a class="btn btn--primary js-convo" href={href} data-topic={cta.topic} data-track="cta_click" data-track-place="page-hero">
              {cta.label}
            </a>
          </div>
        )}
        <slot />
      </div>
      {video && <VideoFrame video={video} eager />}
    </div>
  </div>
</section>
