---
// Contact form, used in the dialog and on /contact. Posts to Web3Forms and works without JavaScript.
// Without a key, contact.ts composes an email to the company address instead.
// The form has no novalidate attribute: without JavaScript the browser checks the required fields.
// contact.ts sets form.noValidate when it runs and shows its own messages.
import { site } from '../data/site';

interface Props {
  /** Unique prefix so the dialog and page forms never share ids. */
  idPrefix: string;
}

const { idPrefix } = Astro.props;
const id = (name: string) => `${idPrefix}-${name}`;
const stages = ['Pre-clinical', 'Phase I', 'Phase II', 'Phase III', 'Launch', 'Commercial', 'Trial close-out', 'Not sure yet'];
const hasKey = site.web3formsKey !== '';
---

<div class="contact-form" data-contact-form data-has-key={hasKey ? 'true' : 'false'} data-email={site.email}>
  <form
    class="form"
    method="POST"
    action={hasKey ? 'https://api.web3forms.com/submit' : `mailto:${site.email}`}
    enctype={hasKey ? undefined : 'text/plain'}
  >
    {hasKey && <input type="hidden" name="access_key" value={site.web3formsKey} />}
    <input type="hidden" name="subject" value="Website enquiry: viaclin.com" />
    <input type="hidden" name="from_name" value="Viaclin website" />
    <input type="hidden" name="redirect" value={`${site.url}/thanks`} />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />
    <input type="hidden" name="utm_source" data-utm />
    <input type="hidden" name="utm_medium" data-utm />
    <input type="hidden" name="utm_campaign" data-utm />
    <input type="hidden" name="utm_term" data-utm />
    <input type="hidden" name="utm_content" data-utm />
    <input type="hidden" name="landing_page" data-utm />
    <input type="hidden" name="gclid" data-utm />
    <input type="hidden" name="msclkid" data-utm />

    <div class="form__summary" role="alert" tabindex="-1" data-summary></div>

    <div class="field">
      <label for={id('name')}>Name</label>
      <input id={id('name')} name="name" type="text" autocomplete="name" required aria-describedby={id('name-error')} data-label="Name" />
      <p class="field__error" id={id('name-error')}></p>
    </div>

    <div class="field">
      <label for={id('company')}>Company</label>
      <input id={id('company')} name="company" type="text" autocomplete="organization" required aria-describedby={id('company-error')} data-label="Company" />
      <p class="field__error" id={id('company-error')}></p>
    </div>

    <div class="field">
      <label for={id('email')}>Work email</label>
      <input id={id('email')} name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby={`${id('email-hint')} ${id('email-error')}`} data-label="Work email" />
      <p class="field__hint" id={id('email-hint')}>We reply to this address.</p>
      <p class="field__error" id={id('email-error')}></p>
    </div>

    <div class="field">
      <label for={id('stage')}>Programme stage</label>
      <select id={id('stage')} name="stage" required aria-describedby={id('stage-error')} data-label="Programme stage">
        <option value="">Choose a stage</option>
        {stages.map((stage) => <option value={stage}>{stage}</option>)}
      </select>
      <p class="field__error" id={id('stage-error')}></p>
    </div>

    <div class="field field--full">
      <label for={id('message')}>What do you need?</label>
      <textarea id={id('message')} name="message" rows="6" maxlength="2000" required aria-describedby={`${id('message-hint')} ${id('message-error')}`} data-label="What do you need?"></textarea>
      <p class="field__hint" id={id('message-hint')}>The programme, the phase, the deadline. Two or three lines is plenty.</p>
      <p class="field__error" id={id('message-error')}></p>
    </div>

    <div class="field field--full">
      <label class="check" for={id('consent')}>
        <input id={id('consent')} name="consent" type="checkbox" value="yes" required aria-describedby={id('consent-error')} data-label="Consent" />
        <span>Viaclin may contact me about this enquiry. See the <a href="/privacy">privacy notice</a>.</span>
      </label>
      <p class="field__error" id={id('consent-error')}></p>
    </div>

    <div class="form__foot">
      <button class="btn btn--primary" type="submit" data-submit>
        <span class="spinner" aria-hidden="true"></span>
        <span data-submit-label>Send</span>
      </button>
      <p class="form__note">No sales layer. A senior operator reads every enquiry.</p>
    </div>
  </form>

  <div class="form-done" data-done hidden>
    <h2 tabindex="-1" data-done-title>
      <svg class="tick" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M6 17l7 7L26 9"></path></svg>
      Received.
    </h2>
    <p>
      A Viaclin lead will reply to the address you gave. If it is urgent, email{' '}
      <a href={`mailto:${site.email}?subject=Urgent`}>{site.email}</a> with "urgent" in the subject line.
    </p>
  </div>

  <div class="form-done" data-mailto-done hidden>
    <h2 tabindex="-1" data-mailto-title>Your email is ready to send.</h2>
    <p>
      We opened a draft in your email app with everything you typed. Press send there and it reaches us. If nothing opened, write to{' '}
      <a href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </div>
</div>
