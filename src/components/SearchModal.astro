---
// Site search. One search box with two homes: the dialog that Base renders on every page
// (opened by [data-search-open], "/" or Ctrl K) and, with `inline`, the box on /search.
// Markup and styles live here once; src/scripts/search.ts drives both.
import Icon from './Icon.astro';
import { services } from '../data/nav';
import { site } from '../data/site';

interface Props {
  /** Render the box on its own, without the dialog shell. Used by the /search page. */
  inline?: boolean;
}

const { inline = false } = Astro.props;
const id = inline ? 'search-page' : 'search-dlg';
const host = new URL(site.url).host;
const Shell = inline ? 'div' : 'dialog';
const shell = inline
  ? { class: 'search-inline' }
  : { class: 'dialog', id: 'search-dialog', 'aria-labelledby': `${id}-title`, 'data-pagefind-ignore': 'all' };
const skeleton = [
  [38, 94, 72, 26],
  [46, 88, 80, 32],
  [30, 96, 64, 22],
];
---

<Shell {...shell}>
  <div
    class:list={['search', 'glass', inline ? 'search--inline' : 'dialog__panel']}
    data-search-root={inline ? 'page' : 'dialog'}
    data-state="idle"
    data-host={host}
  >
    {!inline && <h2 class="sr-only" id={`${id}-title`}>Search the site</h2>}

    <form class="search__form" role="search" action="/search" method="get" data-search-form>
      <label class:list={['search__label', !inline && 'sr-only']} for={`${id}-input`}>Search the site</label>
      <div class="search__row">
        <div class="search__field">
          <Icon name="search" class="search__glyph" />
          <input
            class="search__input"
            id={`${id}-input`}
            name="q"
            type="search"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="search"
            maxlength="80"
            placeholder="Try close-out or serialisation"
            data-search-input
          />
          <button class="search__clear" type="button" data-search-clear hidden>Clear</button>
        </div>
        {!inline && (
          <button class="icon-btn search__close" type="button" data-dialog-close aria-label="Close search">
            <Icon name="close" />
          </button>
        )}
      </div>
    </form>

    <p class="search__status" id={`${id}-status`} role="status" aria-live="polite" data-search-status></p>

    <div class="search__body" role="region" aria-label="Search results" data-search-body>
      {inline && (
        <p class="search__note search__nojs">
          Search runs in the browser and needs JavaScript. The pages below are a good place to start.
        </p>
      )}

      <div data-search-panel="idle">
        <p class="search__note">Type a word or two. Results appear as you type.</p>
      </div>

      <div data-search-panel="loading" aria-hidden="true" hidden>
        {skeleton.map((row) => (
          <div class="search-skel">
            {row.map((width) => <span class="search-skel__bar" style={`--w:${width}%`}></span>)}
          </div>
        ))}
      </div>

      <div data-search-panel="results" hidden>
        <ol class="search__list" role="list" data-search-list></ol>
        <p class="search__more" data-search-more hidden>
          <a class="text-link" href="/search" data-search-more-link>See all results</a>
        </p>
      </div>

      <div data-search-panel="empty" hidden>
        <p class="search__note">
          Try a shorter term or a different word. If the site does not answer the question, <a href="/contact">tell us what you need</a> and we will point you to it.
        </p>
      </div>

      <div data-search-panel="unavailable" hidden>
        <p class="search__note">
          The pages below are a good place to start.
        </p>
      </div>

      <nav class="search__suggest" aria-labelledby={`${id}-suggest`} data-search-suggest>
        <p class="search__kicker" id={`${id}-suggest`}>Suggested pages</p>
        <ul class="search__list" role="list">
          {services.map((item) => (
            <li>
              <a class="search-hit" href={item.href} data-search-hit>
                <span class="search-hit__title">{item.title}</span>
                <span class="search-hit__excerpt">{item.summary}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="search__hints">
      <span>
        <kbd><Icon name="arrow-up" class="search__key-down" /><span class="sr-only">Arrow down</span></kbd>
        <kbd><Icon name="arrow-up" /><span class="sr-only">Arrow up</span></kbd>
        to move
      </span>
      <span><kbd>Enter</kbd> to open</span>
      {inline ? <span><kbd>/</kbd> opens search on any page</span> : <span><kbd>Esc</kbd> to close</span>}
    </div>
  </div>
</Shell>

<style>
  /* ───────── shell ───────── */
  /* The dialog hangs from the top so the panel grows downwards as results arrive. */
  :global(#search-dialog) {
    --search-top: clamp(12px, 11vh, 120px);
    max-width: min(680px, calc(100vw - 24px));
    margin-top: var(--search-top);
  }

  /* --pad is the panel gutter; --inset lines body text up with the result titles */
  .search {
    --pad: 16px;
    --inset: 24px;
    --search-sheen: color-mix(in srgb, var(--white) 78%, transparent);
    display: flex;
    flex-direction: column;
    padding: 0;
    color: var(--fg-2);
  }

  :global(:root[data-theme='dark']) .search {
    --search-sheen: color-mix(in srgb, var(--white) 12%, transparent);
  }

  .search.dialog__panel {
    max-height: calc(100svh - var(--search-top) - 12px);
    overflow: hidden;
    border-radius: var(--radius-xl);
  }

  .search--inline {
    --pad: clamp(16px, 3vw, 32px);
    max-width: 820px;
    border-radius: var(--radius-xl);
  }

  /* ───────── field ───────── */
  .search__form {
    padding: var(--pad) var(--pad) 0;
  }

  .search__label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg);
  }

  .search__row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .search__field {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 56px;
    padding: 0 6px 0 16px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg);
    transition: border-color var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease);
  }

  .search__field:hover {
    border-color: var(--fg-3);
  }

  .search__field:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .search__field :global(.search__glyph) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--fg-3);
    transition: color var(--dur-1) var(--ease);
  }

  .search__field:focus-within :global(.search__glyph) {
    color: var(--link);
  }

  .search__input {
    flex: 1;
    min-width: 0;
    height: 54px;
    padding: 0 8px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--fg);
    font-size: var(--text-base);
    -webkit-appearance: none;
    appearance: none;
  }

  .search__input::placeholder {
    color: var(--fg-3);
    opacity: 1;
  }

  /* the field carries the focus ring for its input */
  .search__input:focus-visible {
    box-shadow: none;
  }

  /* our own Clear button replaces the small built-in one */
  .search__input::-webkit-search-cancel-button,
  .search__input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .search__clear {
    flex: none;
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--fg-2);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: background-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }

  .search__clear:hover {
    background: var(--accent-soft);
    color: var(--fg);
  }

  .search__close {
    flex: none;
  }

  /* ───────── status and body ───────── */
  .search__status {
    padding: 14px var(--pad) 0 calc(var(--pad) + var(--inset));
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--fg);
  }

  .search__status:empty {
    display: none;
  }

  .search__body {
    flex: 1;
    min-height: 0;
    padding: 10px var(--pad) 14px;
  }

  .search.dialog__panel .search__body {
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .search--inline .search__body {
    padding-bottom: clamp(16px, 2.4vw, 24px);
  }

  /* a newer query is on its way: the last results stay in place, dimmed */
  .search__body [data-search-panel='results'] {
    transition: opacity var(--dur-1) var(--ease);
  }

  .search__body[aria-busy='true'] [data-search-panel='results'] {
    opacity: 0.55;
  }

  .search__note {
    padding: 8px 16px 8px var(--inset);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--fg-2);
    max-width: 62ch;
  }

  .search__kicker {
    padding: 12px 16px 6px var(--inset);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--fg-2);
  }

  .search__suggest {
    margin-top: 2px;
  }

  .search__list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search__more {
    padding: 12px 16px 4px var(--inset);
    font-size: var(--text-sm);
  }

  /* ───────── one result (also built by search.ts, hence :global) ───────── */
  .search :global(.search-hit) {
    position: relative;
    display: grid;
    gap: 3px;
    min-height: 48px;
    padding: 12px 16px 12px var(--inset);
    border-radius: var(--radius);
    color: var(--fg-2);
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease);
  }

  /* a short length of route lights beside the row in hand */
  .search :global(.search-hit::before) {
    content: '';
    position: absolute;
    left: 9px;
    top: 14px;
    bottom: 14px;
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
    opacity: 0;
    transform: scaleY(0.2);
    transform-origin: center top;
  }

  .search :global(.search-hit:hover),
  .search :global(.search-hit:focus-visible) {
    background: var(--accent-soft);
    color: var(--fg-2);
  }

  .search :global(.search-hit:focus-visible) {
    border-radius: var(--radius);
  }

  .search :global(.search-hit:hover::before),
  .search :global(.search-hit:focus-visible::before) {
    opacity: 1;
    transform: none;
  }

  .search :global(.search-hit__title) {
    color: var(--fg);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  .search :global(.search-hit__excerpt) {
    font-size: var(--text-sm);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .search :global(.search-hit__url) {
    margin-top: 1px;
    color: var(--link);
    font-size: var(--text-xs);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .search :global(.search-hit mark) {
    padding: 0 3px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--fg);
    font-weight: 600;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* ───────── loading skeleton ───────── */
  .search-skel {
    display: grid;
    gap: 9px;
    padding: 14px 16px 14px var(--inset);
  }

  .search-skel__bar {
    position: relative;
    overflow: hidden;
    display: block;
    width: var(--w, 60%);
    height: 11px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--fg-3) 22%, transparent);
  }

  .search-skel__bar:first-child {
    height: 15px;
    margin-bottom: 2px;
    background: color-mix(in srgb, var(--fg-3) 32%, transparent);
  }

  /* ───────── key hints ───────── */
  .search__hints {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    padding: 12px var(--pad) 12px calc(var(--pad) + var(--inset));
    border-top: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg-alt) 70%, transparent);
    font-size: var(--text-xs);
    color: var(--fg-2);
  }

  .search__hints span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .search__hints kbd {
    display: inline-grid;
    place-items: center;
    min-width: 26px;
    height: 24px;
    padding: 0 6px;
    border: 1px solid var(--rule);
    border-bottom-width: 2px;
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
  }

  .search__hints kbd :global(.icon) {
    width: 12px;
    height: 12px;
    stroke-width: 2.6;
  }

  .search__hints kbd :global(.search__key-down) {
    transform: rotate(180deg);
  }

  /* touch screens have no arrow keys to hint at */
  @media (hover: none) and (pointer: coarse) {
    .search__hints {
      display: none;
    }
  }

  /* ───────── without script ───────── */
  .search__nojs {
    display: none;
  }

  :global(.no-js) .search__nojs {
    display: block;
  }

  :global(.no-js) .search__form,
  :global(.no-js) .search__hints,
  :global(.no-js) .search [data-search-panel='idle'] {
    display: none;
  }

  :global(.no-js) .search--inline .search__body {
    padding-top: clamp(16px, 2.4vw, 24px);
  }

  /* ───────── motion ───────── */
  @media (prefers-reduced-motion: no-preference) {
    .search :global(.search-hit::before) {
      transition: transform var(--dur-2) var(--ease), opacity var(--dur-1) var(--ease);
    }

    .search :global(.search-hit--new) {
      animation: search-rise 420ms var(--ease) both;
      animation-delay: calc(var(--i, 0) * 45ms);
    }

    .search-skel__bar::after {
      content: '';
      position: absolute;
      inset: 0;
      transform: translateX(-100%);
      background: linear-gradient(90deg, transparent, var(--search-sheen), transparent);
      animation: search-shimmer 1500ms var(--ease-in-out) infinite;
    }
  }

  @keyframes search-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
    }
  }

  @keyframes search-shimmer {
    to {
      transform: translateX(100%);
    }
  }

  @media (max-width: 520px) {
    /* a phone keyboard takes half the screen: start the panel at the top and drop the key hints */
    :global(#search-dialog) {
      --search-top: 12px;
    }

    .search,
    .search--inline {
      --pad: 12px;
      --inset: 20px;
    }

    .search__hints {
      display: none;
    }

    .search__field {
      padding-left: 12px;
    }
  }
</style>
