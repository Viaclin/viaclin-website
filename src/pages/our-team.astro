---
// Our Team: the network, the method and coverage. The hero graphic shows the idea behind the page: a
// network of consultants to draw from, and the one who fits matched to the task. Copy source:
// VIACLIN_WEBSITE_SPEC.md section 8.6, renamed at the owner's request; shared copy comes from
// src/data/services.ts. The old address redirects here (redirects in astro.config.mjs and vercel.json).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Blocks from '../components/Blocks.astro';
import Steps from '../components/Steps.astro';
import NetworkVisual from '../components/NetworkVisual.astro';
import TeamMatch from '../components/TeamMatch.astro';
import ContactBand from '../components/ContactBand.astro';
import { site } from '../data/site';
import { network, method, coverage } from '../data/services';

const path = '/our-team';
const pageName = 'Our Team';
const description =
  'The Viaclin team: one accountable lead, a network of senior consultants matched to each task, the Diagnose, Embed, Deliver method and EU, US and UK coverage.';

const onPage = [
  { id: 'network', label: 'The network' },
  { id: 'method', label: 'The method' },
  { id: 'coverage', label: 'Coverage' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: pageName, item: `${site.url}${path}` },
  ],
};
---

<Base title="Our Team: Viaclin" description={description} path={path} schema={schema}>
  <PageHero
    title={pageName}
    lead="One lead operator. A network behind them."
    crumbs={[{ title: pageName }]}
    cta={{ label: 'Start a Conversation' }}
  >
    <nav class="onpage" aria-label="On this page" data-reveal style="--d:300ms">
      <ol role="list">
        {onPage.map((item) => (
          <li><a href={`#${item.id}`}>{item.label}</a></li>
        ))}
      </ol>
    </nav>
    <TeamMatch slot="media" />
  </PageHero>

  <!-- the network -->
  <section class="section" id="network" aria-labelledby="network-title">
    <div class="container">
      <div class="split net-split">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Who does the work</p>
          <h2 id="network-title">The network</h2>
          <p class="lead">
            Viaclin draws on a bank of senior consultants across the EU, US and UK, each with a distinct specialism and
            their own industry history. Your engagement gets one accountable lead, and the lead gets the whole bench.
            Every consultant on it works to one aim: getting each therapy to the patients who need it.
          </p>
        </div>
        <NetworkVisual />
      </div>
      <Blocks items={network} cols={3} />
    </div>
  </section>

  <!-- the method -->
  <Section id="method" tone="mist" eyebrow="Method" title="Diagnose, Embed, Deliver">
    <Steps items={method} row />
  </Section>

  <!-- coverage: on the white ground, so the grounds keep alternating from the method band to the contact band -->
  <Section
    id="coverage"
    eyebrow="Coverage"
    title="Three regulatory jurisdictions"
    intro="Each sets its own rules for getting a therapy to patients. The network works inside all three."
  >
    <Blocks items={coverage} cols={3} />
  </Section>

  <ContactBand />
</Base>

<style>
  /* hero: numbered jump links to the three parts of the page */
  .onpage {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .onpage ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 28px);
    margin: 0;
    counter-reset: onpage;
  }

  .onpage li {
    counter-increment: onpage;
  }

  .onpage a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 64px;
    padding-top: var(--space-3);
    color: var(--fg);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
  }

  .onpage a::before {
    content: counter(onpage, decimal-leading-zero);
    color: var(--link);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  /* the block rule: grey track, green segment that runs the full width on hover */
  .onpage a::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent) 0 50%, var(--rule) 50% 100%);
    background-size: 200% 100%;
    background-position: 84% 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .onpage a {
      transition: color var(--dur-1) var(--ease);
    }

    .onpage a::after {
      transition: background-position 600ms var(--ease);
    }
  }

  .onpage a:hover,
  .onpage a:focus-visible {
    color: var(--link);
  }

  .onpage a:hover::after,
  .onpage a:focus-visible::after {
    background-position: 0 0;
  }

  /* network: intro beside the diagram, the three columns beneath */
  .net-split {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .net-split .section-head {
    margin-bottom: 0;
  }

  .net-split :global(.netviz) {
    width: 100%;
    max-width: 480px;
    justify-self: center;
  }

  /* the three links keep one row down to the phone; the gap tightens so each label has room */
  @media (max-width: 900px) {
    .onpage ol {
      gap: 8px 16px;
    }
  }

  @media (max-width: 339px) {
    .onpage ol {
      grid-template-columns: minmax(0, 1fr);
    }

    .onpage a {
      min-height: 56px;
    }
  }
</style>
