---
// Project Management. Copy source: VIACLIN_WEBSITE_SPEC.md section 8.3, recast in the owner's assertive voice
// of September 2026: a senior team that drives, executes and delivers with precision.
// October 2026: more mentions of patients, each a clause that names where the work protects supply to them.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Blocks from '../../components/Blocks.astro';
import Steps from '../../components/Steps.astro';
import ContactBand from '../../components/ContactBand.astro';
import { site } from '../../data/site';

const path = '/services/project-management';
const pageName = 'Project Management';
const description =
  'Precision project management for life sciences. A senior team drives tech transfer, CDMO programmes, serialisation and launch, with applied AI.';

const driveSteps = [
  {
    title: 'Scope and charter creation',
    body: 'Objectives, boundaries, decision rights and the definition of done, set in week one and signed off by your sponsor.',
  },
  {
    title: 'One plan',
    body: 'Budget, schedule, risk register and action log, owned by the Viaclin lead and open to your team at all times. Every action carries an owner and a date.',
  },
  {
    title: 'Decisions in the open',
    body: 'A weekly decisions log to your leadership, each item framed with options and a firm recommendation, so decisions close on time and the schedule holds.',
  },
  {
    title: 'Applied AI in the plan',
    body: 'Project management is on the frontier of applied AI. Our tools read the plan, the risk register and the vendor data together, so you get full visibility, sharper risk calls and a level of control that no status report can give.',
  },
  {
    title: 'Handover',
    body: 'Documentation, trained owners and a closed action log. The capability stays with you, and your team runs it from here.',
  },
];

const oversight = [
  {
    title: 'Tech transfer, scale-up and PPQ',
    body: 'Transfer planning and receiving-site readiness, analytical method transfer and laboratory testing oversight, then process performance qualification and a controlled handover into routine manufacturing, with supply to patients protected through the move.',
  },
  {
    title: 'CDMO and CMO programmes',
    body: 'Your CDMOs and CMOs held to the plan: slot management, batch records, deviations, campaign reports and the commercial terms behind them.',
  },
  {
    title: 'Packaging and serialisation',
    body: 'Packaging definition, artwork and label drafting, serialisation adoption and packaging line readiness, executed to your launch date.',
  },
  {
    title: 'Cross-border logistics and launch',
    body: 'Strategic launch sequencing by market, with importer of record, licences, bonds, cold chain routes and depot strategy settled in advance, so treatment can reach patients in each market from launch day.',
  },
  {
    title: 'Global site readiness',
    body: 'Pharmacy manuals, storage capability, IRT integration and first-patient readiness, driven to one standard in every country.',
  },
  {
    title: 'Interim leadership',
    body: 'A senior project owner who steps in and takes charge while you hire, restructure or scale.',
  },
];

const engage = [
  { title: 'Run', body: 'A Viaclin lead takes full ownership and drives the project end to end.' },
  { title: 'Retain', body: 'Strategic oversight across your portfolio from a fractional project owner, a set number of days each month.' },
  { title: 'Diagnose', body: 'A project health check that pinpoints where the plan, the risks and vendor performance stand, with a written recovery route.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${site.url}${path}#service`,
    name: pageName,
    description,
    serviceType: 'Life sciences project management',
    url: `${site.url}${path}`,
    areaServed: ['IE', 'EU', 'US', 'GB'],
    provider: { '@id': `${site.url}/#organisation` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: pageName, item: `${site.url}${path}` },
    ],
  },
];
---

<Base title="Project Management: Viaclin" description={description} path={path} schema={schema}>
  <PageHero
    title={pageName}
    lead="End-to-end ownership of the projects that decide your timeline. We drive scope, schedule, budget, regulatory alignment, risk and operations from concept to patient delivery."
    eyebrow="Service area"
    crumbs={[{ title: 'Services', href: '/#services' }, { title: pageName }]}
    cta={{ label: 'Start a Conversation' }}
    video="labelling"
  />

  <!-- how we drive your project: the heading holds its place while the five steps pass -->
  <section class="section section--mist" id="how-we-drive" aria-labelledby="how-we-drive-title">
    <div class="container run-split">
      <div class="run-split__head" data-reveal>
        <p class="eyebrow">Driving delivery</p>
        <h2 id="how-we-drive-title">How we drive your project</h2>
        <p class="lead">A senior Viaclin lead owns the plan, drives every decision to a close and answers for delivery.</p>
        <p class="pull">Full oversight, without the overhead.</p>
      </div>
      <Steps items={driveSteps} />
    </div>
  </section>

  <!-- pivotal oversight -->
  <Section
    id="pivotal-oversight"
    eyebrow="Precision"
    title="Pivotal oversight"
    intro="The critical path of your programme, from the first batch to the first patient, owned by a senior lead and executed with precision."
  >
    <div class="rows"><Blocks items={oversight} cols={2} /></div>
  </Section>

  <!-- your needs, our services -->
  <Section
    id="your-needs"
    tone="mist"
    eyebrow="Engagement"
    title="Your needs, our services"
    intro="Three ways to engage. Each one puts a senior lead in charge of the result."
  >
    <Blocks items={engage} cols={3} />
  </Section>

  <ContactBand />
</Base>

<style>
  .run-split {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  .run-split__head {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .run-split__head > * + * {
    margin-top: var(--space-4);
  }

  /* the lead reads as a section-head lead: quieter than the heading and the pull line */
  .run-split__head .lead {
    max-width: 34ch;
    color: var(--fg-2);
  }

  /* the pull line sums up the method beside the steps */
  .run-split__head .pull {
    max-width: 22ch;
    margin-top: var(--space-6);
    padding-left: var(--space-5);
    border-left: 2px solid var(--accent);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.4;
    color: var(--fg);
  }

  /* two-column block grids run to several rows: open the rows up so each rule reads as a new start */
  .rows :global(.grid) {
    row-gap: clamp(36px, 4.4vw, 56px);
  }

  /* dark theme: the mist ground and the contact band share a colour, so a hairline marks the seam */
  :global(:root[data-theme='dark'] .section--mist + .cband) {
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 900px) {
    .run-split {
      grid-template-columns: minmax(0, 1fr);
    }

    .run-split__head {
      position: static;
    }

    .run-split__head .lead {
      max-width: 60ch;
    }

    .run-split__head .pull {
      margin-top: var(--space-5);
    }
  }
</style>
