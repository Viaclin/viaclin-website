---
// Supply Chain Consultancy. Copy source: VIACLIN_WEBSITE_SPEC.md section 8.2, revised with the owner's hero lead.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Blocks from '../../components/Blocks.astro';
import ArcDiagram from '../../components/ArcDiagram.astro';
import ContactBand from '../../components/ContactBand.astro';
import { site } from '../../data/site';

const path = '/services/supply-chain-consultancy';
const pageName = 'Supply Chain Consultancy';
const description =
  'Bespoke life sciences supply chain consultancy: planning and forecasting, clinical supply, external manufacturing, procurement and value chain strategy.';

const technology = [
  {
    title: 'Simplify your supply',
    body: 'One supply model from development to commercial, with fewer handoffs between functions and partners and one owner for the whole chain.',
  },
  {
    title: 'Secure your supply',
    body: 'Risk-based safety stock and dual sourcing. Cold chain control and excursion response. Oversight of the suppliers your programme depends on.',
  },
  {
    title: 'Scale operations',
    body: 'From first-in-human to launch and post-launch: new product introduction, market rollout and life cycle management.',
  },
];

const takeOn = [
  {
    title: 'Planning and forecasting',
    body: 'S&OP ownership and demand planning on SAP and Anaplan. Patient-level modelling: recruitment, dosing intervals, dropout. Risk-based safety stock. Scenario planning and CMO capacity alignment. Launch ramp and market rollout sequencing.',
  },
  {
    title: 'Clinical trial supply',
    body: 'Investigational product protected at every step, from first-in-human dosing to final reconciliation. IRT and IXRS set-up, management and decommissioning. Clinical packaging, labelling and booklet design. Cold chain and GDP distribution with excursion response. QP release, QPPV networks and import licences. Pharmacy manuals and site readiness. Structured trial close-out, from reconciliation to destruction.',
  },
  {
    title: 'External development and manufacturing',
    body: 'CDMO and CRO scouting and sourcing. RFQ management from specification to award. Product tech transfer into the receiving site. Slot management, batch records and campaign oversight.',
  },
  {
    title: 'Procurement',
    body: 'Sourcing, contracting and delivery. Supplier performance, savings and compliance. Public tenders prepared and managed. Tariffs, import duties and customs clearance.',
  },
  {
    title: 'Supply network and risk',
    body: 'Inventory strategy, depot network and FIFO control. Dual sourcing, backup site qualification and safety stock sized to risk.',
  },
  {
    title: 'Greenfield operations set-up',
    body: 'New market, new facility or new function, built from a blank page to a licensed, running capability. Licensing pathways with HPRA, MHRA, FDA and EMA. SOP development, quality systems and GMP readiness. ERP selection and implementation. CMO network design and backup site qualification. Serialisation and packaging line adoption.',
  },
];

const strategy = [
  {
    title: 'Value chain strategy',
    body: 'Where value is made and lost across development, manufacturing and supply, and the choices that follow: what to keep in house, what to place with partners and where to invest.',
  },
  {
    title: 'Target operating model',
    body: 'The organisation, processes, systems and partners the supply chain needs for its next phase, set out as one model with clear decision rights.',
  },
  {
    title: 'SCM transformation',
    body: 'Systems, data, roles and partners moved to the target model, with the change managed alongside your team.',
  },
  {
    title: 'New product introduction and post-launch',
    body: 'NPI planning and launch readiness, then the steady state and the life cycle changes that follow.',
  },
];

const engage = [
  {
    title: 'Embedded',
    body: 'A senior operator inside your team for a defined scope and period, in your systems and your meetings.',
  },
  {
    title: 'Fractional',
    body: 'A set number of days each month for programmes that need a steady hand rather than a full-time hire.',
  },
  {
    title: 'Projectised',
    body: 'A defined project with a charter, a plan and an end date, owned by a Viaclin lead.',
  },
  {
    title: 'Ad hoc consulting',
    body: 'A question answered, a document reviewed or a decision supported, without a retainer.',
  },
];

// Supporting artwork repeats words from the copy beside it, so it stays hidden from assistive tech and search.
const routeStops = ['Planning', 'Procurement', 'Manufacturing oversight'];
const routeYs = [30, 110, 190];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${site.url}${path}#service`,
    name: pageName,
    description,
    serviceType: 'Life sciences supply chain consultancy',
    url: `${site.url}${path}`,
    areaServed: ['IE', 'EU', 'US', 'GB'],
    provider: { '@id': `${site.url}/#organisation` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: pageName, item: `${site.url}${path}` },
    ],
  },
];
---

<Base title="Supply Chain Consultancy: Viaclin" description={description} path={path} schema={schema}>
  <PageHero
    title={pageName}
    lead="End-to-end bespoke solutions that de-risk and accelerate our partners' and sponsors' drug and device development programmes."
    eyebrow="Service area"
    crumbs={[{ title: 'Services', href: '/#services' }, { title: pageName }]}
    cta={{ label: 'Start a conversation' }}
    video="pumps"
  />

  <!-- intro -->
  <Section>
    <div class="lead-split">
      <div class="lead-split__copy" data-reveal>
        <p class="eyebrow">Our role</p>
        <p class="lead lead--intro">
          We take ownership of planning, procurement and manufacturing oversight. Engagements run inside your quality
          system and your tools. Specialist questions route across the Viaclin network and come back answered.
        </p>
      </div>
      <div class="route miniroute" data-reveal="fade" aria-hidden="true" data-pagefind-ignore>
        <svg viewBox="0 0 340 220" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path class="route__bracket" d="M26 30 h-12 v160 h12"></path>
          <line class="route__line" x1="56" y1="30" x2="56" y2="190"></line>
          {routeYs.map((y, i) => <circle class="route__node" cx="56" cy={y} r="9" style={`--i:${i}`}></circle>)}
          {routeStops.map((stop, i) => (
            <text class="route__label" x="84" y={routeYs[i]} dominant-baseline="middle" style={`--i:${i}`}>{stop}</text>
          ))}
        </svg>
      </div>
    </div>
  </Section>

  <!-- perspective: linear, network, value -->
  <ArcDiagram />

  <!-- technology and expertise -->
  <Section
    id="technology"
    eyebrow="Technology and expertise"
    title="Transforming supply chains through technology and expertise"
    intro="Supply chains for clinical and commercial programmes have to be tailored to the product, the phase and the markets. We build them with senior operators and the newest tools in the field, and we run them with your team."
  >
    <div class="rows"><Blocks items={technology} cols={3} /></div>
  </Section>

  <!-- what we take on -->
  <Section id="what-we-take-on" tone="mist" eyebrow="Scope" title="What we take on">
    <div class="rows"><Blocks items={takeOn} cols={2} /></div>
  </Section>

  <!-- strategy -->
  <Section
    id="strategy"
    eyebrow="Strategy"
    title="Shape the future of your value chain"
    intro="Value chain strategy and a target operating model, then the transformation programme that gets you there."
  >
    <div class="rows"><Blocks items={strategy} cols={4} /></div>
  </Section>

  <!-- ways to engage -->
  <Section id="ways-to-engage" tone="mist" eyebrow="Engagement" title="Ways to engage">
    <div class="rows"><Blocks items={engage} cols={2} /></div>
  </Section>

  <!-- how it starts -->
  <section class="section" id="how-it-starts" aria-labelledby="how-it-starts-title">
    <div class="container">
      <div class="section-head start" data-reveal>
        <p class="eyebrow">First step</p>
        <h2 id="how-it-starts-title">How it starts</h2>
        <p class="lead start__lead">
          A thirty-minute call. We ask about the programme, the phase, the systems and the deadline. If we can help,
          you get a written proposal: scope, named lead, network specialists, timeline and fee. If we cannot, we say
          so and point you to someone who can.
        </p>
      </div>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  /* a single paragraph set as a lead, with a quiet companion beside it */
  .lead-split {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }

  .lead-split__copy > * + * {
    margin-top: var(--space-5);
  }

  .lead--intro {
    max-width: 34em;
    font-size: clamp(1.25rem, 1.9vw, 1.5rem);
    line-height: 1.45;
    letter-spacing: -0.005em;
  }

  /* a short vertical route segment, drawn with the shared route classes */
  .miniroute {
    width: 100%;
    max-width: 340px;
    justify-self: end;
  }

  .miniroute .route__label {
    font-size: 18px;
  }

  /* block grids that run to several rows, stacked on a phone or two by two: open the rows up so each rule reads as a new start */
  .rows :global(.grid) {
    row-gap: clamp(36px, 4.4vw, 56px);
  }

  /* the last section before the band: the heading and one paragraph, so no space is held for a grid below */
  .start {
    margin-bottom: 0;
  }

  .start__lead {
    max-width: 52ch;
  }

  @media (max-width: 900px) {
    .lead-split {
      grid-template-columns: minmax(0, 1fr);
    }

    .miniroute {
      max-width: 300px;
      justify-self: start;
    }
  }
</style>
