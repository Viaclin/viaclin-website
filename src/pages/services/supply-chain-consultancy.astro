---
// Supply Chain Consultancy. Copy source: VIACLIN_WEBSITE_SPEC.md section 8.2, revised with the owner's hero lead
// and the owner's direction for a more confident voice: an elite senior team that drives and executes with precision.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Blocks from '../../components/Blocks.astro';
import ArcDiagram from '../../components/ArcDiagram.astro';
import ContactBand from '../../components/ContactBand.astro';
import { site } from '../../data/site';

const path = '/services/supply-chain-consultancy';
const pageName = 'Supply Chain Consultancy';
const description =
  'Senior life sciences supply chain consultancy: planning, clinical supply, external manufacturing, laboratory testing, procurement and value chain strategy.';

const technology = [
  {
    title: 'Simplify your supply',
    body: 'One supply model from development to commercial. Fewer handoffs between functions and partners, and one accountable owner for the whole chain.',
  },
  {
    title: 'Secure your supply',
    body: 'Risk-based safety stock and dual sourcing. Cold chain control and a decisive excursion response. Strategic oversight of every supplier your programme depends on.',
  },
  {
    title: 'Scale operations',
    body: 'Accelerating from first-in-human to launch and beyond: new product introduction, market rollout and life cycle management, executed to plan.',
  },
];

const oversight = [
  {
    title: 'Planning and forecasting',
    body: 'S&OP ownership and demand planning on SAP and Anaplan. Patient-level modelling: recruitment, dosing intervals, dropout. Risk-based safety stock. Scenario planning and CMO capacity alignment. Launch ramp and market rollout sequencing.',
  },
  {
    title: 'Clinical trial supply',
    body: 'Investigational product protected at every step, from first-in-human dosing to final reconciliation. IRT and IXRS set-up, management and decommissioning. Clinical packaging, labelling and booklet design. Cold chain and GDP distribution with excursion response. QP release, QPPV networks and import licences. Pharmacy manuals and site readiness. Structured trial close-out, from reconciliation to destruction.',
  },
  {
    title: 'External development and manufacturing',
    body: 'CDMO and CRO scouting and sourcing. RFQ management from specification to award. Product tech transfer into the receiving site. Slot management, batch records and campaign oversight.',
  },
  {
    title: 'Procurement',
    body: 'Strategic sourcing, contracting and delivery. Supplier performance, savings and compliance. Public tenders prepared and managed. Tariffs, import duties and customs clearance.',
  },
  {
    title: 'Supply network and risk',
    body: 'Inventory strategy, depot network and FIFO control. Dual sourcing, backup site qualification and safety stock sized to risk.',
  },
  {
    title: 'Greenfield operations set-up',
    body: 'New market, new facility or new function, built from a blank page to a licensed, running capability. Licensing pathways with HPRA, MHRA, FDA and EMA. SOP development, quality systems and GMP readiness. ERP selection and implementation. CMO network design and backup site qualification. Serialisation and packaging line adoption.',
  },
  {
    title: 'Laboratory testing oversight',
    body: 'Release and stability testing programmes. Contract laboratory management. Sample logistics and chain of custody. Analytical method transfer. Results expedited when a release date depends on them.',
  },
  {
    title: 'Quality and regulatory alignment',
    body: 'QP and QPPV coordination. Deviations, change control and licence variations handled with precision, without stalling supply.',
  },
];

const strategy = [
  {
    title: 'Value chain strategy',
    body: 'We pinpoint where value is made and lost across development, manufacturing and supply, then set the choices that follow: what stays in house, what goes to partners and where to invest.',
  },
  {
    title: 'Target operating model',
    body: 'The organisation, processes, systems and partners your supply chain needs for its next phase, defined as one model with clear decision rights.',
  },
  {
    title: 'SCM transformation',
    body: 'Systems, data, roles and partners moved onto the target model. We drive the change with your team and execute it to plan.',
  },
  {
    title: 'New product introduction and post-launch',
    body: 'NPI planning and launch readiness that accelerate the path to market, then the steady state and the life cycle changes that follow.',
  },
];

const engage = [
  {
    title: 'Embedded',
    body: 'A senior operator inside your team for a defined scope and period, executing in your systems and your meetings.',
  },
  {
    title: 'Fractional',
    body: 'Senior capacity for a set number of days each month, for programmes that need a steady hand rather than a full-time hire.',
  },
  {
    title: 'Projectised',
    body: 'A defined project with a charter, a plan and an end date, driven to completion by a Viaclin lead.',
  },
  {
    title: 'Ad hoc consulting',
    body: 'A precise answer when you need one: a question resolved, a document reviewed or a strategic decision supported, without a retainer.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${site.url}${path}#service`,
    name: pageName,
    description,
    serviceType: 'Life sciences supply chain consultancy',
    url: `${site.url}${path}`,
    areaServed: ['IE', 'EU', 'US', 'GB'],
    provider: { '@id': `${site.url}/#organisation` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: pageName, item: `${site.url}${path}` },
    ],
  },
];
---

<Base title="Supply Chain Consultancy: Viaclin" description={description} path={path} schema={schema}>
  <PageHero
    title={pageName}
    lead="End-to-end bespoke solutions that de-risk and accelerate our partners' and sponsors' drug and device development programmes."
    eyebrow="Service area"
    crumbs={[{ title: 'Services', href: '/#services' }, { title: pageName }]}
    cta={{ label: 'Start a conversation' }}
    video="pumps"
  />

  <!-- perspective: linear, network, value, driven by the scroll -->
  <ArcDiagram />

  <!-- technology and expertise -->
  <Section
    id="technology"
    eyebrow="Technology and expertise"
    title="Transforming supply chains through technology and expertise"
    intro="Clinical and commercial programmes demand a supply chain built for the product, the phase and the markets. Our senior operators design it with precision, equip it with the newest tools in the field and drive its execution with your team."
  >
    <div class="rows"><Blocks items={technology} cols={3} /></div>
  </Section>

  <!-- pivotal oversight: eight blocks, so the two-column grid closes on a full row -->
  <Section id="pivotal-oversight" tone="mist" eyebrow="Precision" title="Pivotal oversight">
    <div class="rows"><Blocks items={oversight} cols={2} /></div>
  </Section>

  <!-- strategy -->
  <Section
    id="strategy"
    eyebrow="Strategy"
    title="Shape the future of your value chain"
    intro="Strategic value chain design and a target operating model, then the transformation programme we drive to completion."
  >
    <div class="rows"><Blocks items={strategy} cols={4} /></div>
  </Section>

  <!-- ways to engage -->
  <Section id="ways-to-engage" tone="mist" eyebrow="Engagement" title="Your needs, our services">
    <div class="rows"><Blocks items={engage} cols={2} /></div>
  </Section>

  <!-- how it starts -->
  <section class="section" id="how-it-starts" aria-labelledby="how-it-starts-title">
    <div class="container">
      <div class="section-head start" data-reveal>
        <p class="eyebrow">First step</p>
        <h2 id="how-it-starts-title">How it starts</h2>
        <p class="lead start__lead">
          A thirty-minute call. We ask about the programme, the phase, the systems and the deadline. If we are the
          right team, a written proposal follows: scope, network specialists, timeline and fee. If we are not, we say
          so and point you to someone who is. A named lead, a plan with owners and dates, and delivery we answer for.
        </p>
      </div>
    </div>
  </section>

  <ContactBand />
</Base>

<style>
  /* block grids that run to several rows, stacked on a phone or two by two: open the rows up so each rule reads as a new start */
  .rows :global(.grid) {
    row-gap: clamp(36px, 4.4vw, 56px);
  }

  /* the last section before the band: the heading and one paragraph, so no space is held for a grid below */
  .start {
    margin-bottom: 0;
  }

  .start__lead {
    max-width: 52ch;
  }
</style>
