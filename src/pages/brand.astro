  { role: 'H3', token: '--text-xl', detail: '22 px, semibold 600, leading 1.25', sample: 'Supply Chain Consultancy', css: 'font-size:var(--text-xl);font-weight:600;line-height:1.25;letter-spacing:-0.005em;color:var(--fg)' },
