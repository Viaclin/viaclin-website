<script>
  // Section links: mark the section on screen. Motion demos: replay on request.
  const nav = document.querySelector<HTMLElement>('[data-guide-nav]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (nav && 'IntersectionObserver' in window) {
    const strip = nav.querySelector<HTMLElement>('ul');
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    let current = '';

    const mark = (id: string) => {
      if (id === current) return;
      current = id;
      for (const link of links) {
        if (link.hash === `#${id}`) {
          link.setAttribute('aria-current', 'location');
          if (strip && strip.scrollWidth > strip.clientWidth) {
            const left = link.offsetLeft - (strip.clientWidth - link.offsetWidth) / 2;
            strip.scrollTo({ left, behavior: calm ? 'auto' : 'smooth' });
          }
        } else {
          link.removeAttribute('aria-current');
        }
      }
    };

    // A thin band a third of the way down the screen decides which section is current.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) mark(entry.target.id);
        }
      },
      { rootMargin: '-34% 0px -64% 0px' },
    );

    for (const link of links) {
      const section = document.getElementById(link.hash.slice(1));
      if (section) observer.observe(section);
    }

    // Above the first section no section is current, and the observer has nothing to report there,
    // so the pill is cleared while the first section's top sits below the band.
    const first = links.length ? document.getElementById(links[0].hash.slice(1)) : null;

    if (first) {
      window.addEventListener(
        'scroll',
        () => {
          if (first.getBoundingClientRect().top <= window.innerHeight * 0.36) return;
          current = '';
          for (const link of links) link.removeAttribute('aria-current');
        },
        { passive: true },
      );
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-replay]').forEach((button) => {
    const target = document.getElementById(button.dataset.replay ?? '');
    if (!target) return;
    button.addEventListener('click', () => {
      if (calm) return;
      target.classList.add('is-reset');
      target.classList.remove('is-in');
      void target.offsetWidth;
      target.classList.remove('is-reset');
      requestAnimationFrame(() => target.classList.add('is-in'));
    });
  });
</script>

