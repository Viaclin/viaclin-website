---

<Base
  title="Brand guidelines: Viaclin"
  description="The Viaclin identity in one place: logo, colour, typography, liquid glass, motion, voice, footage and downloads."
  path="/brand"
  noindex
>
  <div data-pagefind-ignore="all">
    <!-- hero -->
    <section class="page-hero brand-hero">
      <div class="hero__bg" aria-hidden="true"></div>
      <div class="container">
        <nav aria-label="Breadcrumb" data-reveal="fade">
          <ol class="breadcrumb">
            <li><a href="/">Home</a></li>
            <li><span aria-current="page">Brand guidelines</span></li>
          </ol>
        </nav>
        <div class="split brand-hero__split">
          <div class="page-hero__copy">
            <p class="eyebrow" data-reveal>Identity</p>
            <h1 data-reveal style="--d:60ms">Brand guidelines</h1>
            <p class="lead" data-reveal style="--d:140ms">
              The Viaclin identity in one place: the V mark, the palette, the type, the glass, the route in motion, the
              voice and the footage. Use it as the reference for anything that carries the name.
            </p>
            <div class="actions" data-reveal style="--d:220ms">
              {pack && (
                <a class="btn btn--primary" href={pack.href} download data-track="cta_click" data-track-place="brand-hero">
                  Download the logo pack
                </a>
              )}
              <a class="btn btn--secondary" href="#downloads">See every file</a>
            </div>
          </div>

          <div class="vframe-wrap board-wrap" data-reveal="scale" aria-hidden="true">
            <div class="board">
              <div class="board__tile board__tile--navy">
                <img src="/brand/logo/viaclin-mark-reversed.svg" alt="" width="356" height="345" />
                <svg viewBox="0 0 200 24" focusable="false">
                  <line x1="8" y1="12" x2="192" y2="12"></line>
                  <circle cx="8" cy="12" r="5"></circle>
                  <circle cx="69" cy="12" r="5"></circle>
                  <circle cx="131" cy="12" r="5"></circle>
                  <circle cx="192" cy="12" r="5"></circle>
                </svg>
              </div>
              <div class="board__tile board__tile--type">
                <span class="board__aa">Aa</span>
                <span class="board__note">Noto Sans</span>
              </div>
              <div class="board__tile board__tile--dots">
                <span style="background:var(--navy)"></span>
                <span style="background:var(--green)"></span>
                <span style="background:var(--green-light)"></span>
                <span style="background:var(--slate)"></span>
                <span style="background:var(--mist)"></span>
              </div>
              <div class="board__tile board__tile--film">
                <img src={`${videos.robot.base}.jpg`} alt="" width="1280" height="720" />
                <span class="chip glass glass--clear">Liquid glass</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- sticky section links -->
    <nav class="guide-nav" aria-label="Sections of the guidelines" data-guide-nav>
      <div class="container">
        <ul role="list">
          {sections.map((item) => (
            <li><a href={`#${item.id}`}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- logo -->
    <Section
      id="logo"
      class="guide-section"
      eyebrow="The mark"
      title="Logo"
      intro="The V mark and the Viaclin wordmark are artwork, kept from the original identity and redrawn as vectors. Three versions, each in colour, reversed and single colour."
    >
      {logoGroups.map((group) => (
        <div class="logo-group">
          <div class="logo-group__head" data-reveal>
            <h3>{group.title}</h3>
            <p>{group.body}</p>
          </div>
          <ul class:list={['tiles', group.key === 'mark' && 'tiles--mark']} role="list">
            {grounds.map((item, index) => (
              <li data-reveal style={`--d:${index * 60}ms`}>
                <figure class="tile">
                  <div class:list={['tile__ground', `tile__ground--${item.ground}`]}>
                    <img
                      src={`/brand/logo/viaclin-${group.key}${item.file}.svg`}
                      alt={`Viaclin ${group.key}, ${item.variant.toLowerCase()}, on ${item.ground}`}
                      width={group.width}
                      height={group.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption>{item.variant} on {item.ground}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="grid grid--2 logo-rules">
        <article class="card guide-card" data-reveal>
          <h3>Clear space</h3>
          <div class="clear" aria-hidden="true">
            <div class="clear__zone">
              <span class="clear__x clear__x--top">x</span>
              <span class="clear__x clear__x--right">x</span>
              <span class="clear__x clear__x--bottom">x</span>
              <span class="clear__x clear__x--left">x</span>
              <div class="clear__logo">
                <Logo variant="lockup" label="" />
                <span class="clear__measure"></span>
              </div>
            </div>
          </div>
          <p>
            Keep a margin equal to the height of the V, marked x, clear on every side. No text, no edges and no other
            logo inside it.
          </p>
        </article>

        <article class="card guide-card" data-reveal style="--d:90ms">
          <h3>Minimum size</h3>
          <div class="minsize">
            <div class="minsize__item">
              <div class="minsize__stage"><Logo variant="lockup" label="" class="minsize__lockup" /></div>
              <p><strong>140 px wide</strong> Lockup and compact logo</p>
            </div>
            <div class="minsize__item">
              <div class="minsize__stage"><Logo variant="mark" label="" class="minsize__mark" /></div>
              <p><strong>24 px wide</strong> Mark</p>
            </div>
          </div>
          <p>
            Below these widths the descriptor and the curve of the V lose their shape. The site header sets the compact
            logo 30 px tall; the footer sets the reversed lockup 54 px tall.
          </p>
        </article>
      </div>

