/* ───────── downloads ───────── */
const publicDir = path.join(process.cwd(), 'public');

interface FileInfo {
  href: string;
  type: string;
  size: string;
}

// Size and type are read from the file on disk at build time. A missing file renders nothing.
function fileInfo(href: string): FileInfo | null {
  try {
    const { size } = fs.statSync(path.join(publicDir, href));
    const ext = path.extname(href).slice(1).toLowerCase();
    const type = ext === 'webmanifest' ? 'JSON' : ext.toUpperCase();
    const label = size < 1024 ? `${size} B` : size < 1024 * 1024 ? `${Math.round(size / 1024)} KB` : `${(size / 1024 / 1024).toFixed(1)} MB`;
    return { href, type, size: label };
  } catch {
    return null;
  }
}

